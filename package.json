{
  "name": "@atlantic-blue/rex",
  "version": "0.1.0",
  "description": "A regular expression engine written from scratch in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit --project scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "check:packed": "node --experimental-strip-types scripts/packed-install-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
